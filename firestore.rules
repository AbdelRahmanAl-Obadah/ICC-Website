rules_version = '2';

/**
 * PHASE 1 — baseline Firestore security rules.
 *
 * This project does not read or write Firestore yet (js/firestore.js and
 * js/auth.js are placeholders). These rules exist so the project is never
 * left with an open database once a real Firebase project is connected.
 *
 * Default posture:
 *   - Public academic content (majors, semesters, subjects, requirements)
 *     is READ-ONLY for anyone, once those collections exist.
 *   - ALL writes are denied until PHASE 3 introduces authenticated admin
 *     checks (see js/auth.js). Do not relax this before that lands.
 *
 * PHASE 2/3 TODO:
 *   - Replace `allow write: if false;` with an isAdmin() check backed by
 *     either custom auth claims or an `admins/{uid}` allowlist document.
 *   - Add rules for the `admins` collection itself (never client-writable).
 *   - Add field-level validation once the final schema is confirmed.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Public academic data — readable by everyone, writable by no one yet.
    match /majors/{majorId} {
      allow read: if true;
      allow write: if false;

      match /semesters/{semesterId} {
        allow read: if true;
        allow write: if false;

        match /subjects/{subjectId} {
          allow read: if true;
          allow write: if false;
        }
      }
    }

    match /requirements/{trackId} {
      allow read: if true;
      allow write: if false;
    }

    // Reserved for Phase 3 admin allowlist — never client-writable.
    match /admins/{uid} {
      allow read: if false;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
